{
  "name": "expressive-code-twinkleplop",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Expressive Code plugin to use Twinkleplop as a syntax highlighter: all the features you already use, at the speed of Twinkleplop.",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./languages/*": {
      "types": "./dist/languages/*/index.d.ts",
      "default": "./dist/languages/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest",
    "lint": "eslint . --cache --max-warnings=0",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@twinkleplop/core": "^0.3.1",
    "@twinkleplop/css": "^0.1.7",
    "@twinkleplop/html": "^0.1.7",
    "@twinkleplop/markdown": "^0.2.1",
    "@twinkleplop/tsx": "^0.1.7",
    "@twinkleplop/yaml": "^0.1.7"
  },
  "devDependencies": {
    "@expressive-code/core": "^0.44.2",
    "@types/node": "^24.19.2",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@expressive-code/core": ">=0.44.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "expressive-code",
    "twinkleplop",
    "plugin",
    "syntax-highlighting",
    "code-blocks",
    "withastro"
  ],
  "homepage": "https://github.com/HiDeoo/expressive-code-twinkleplop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiDeoo/expressive-code-twinkleplop.git",
    "directory": "packages/expressive-code-twinkleplop"
  },
  "bugs": "https://github.com/HiDeoo/expressive-code-twinkleplop/issues"
}
